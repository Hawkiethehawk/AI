# Local Codex runtime state, credentials, sessions, logs, caches.
.codex/
.agents/

# Gitee / local tokens, never commit.
.gitee_token
*.token

# AppMagic browser profiles and account/session data.
.appmagic-auth.json
.appmagic-userdata*/

# Temporary folders and dependencies.
ai-temp/
node_modules/
migration-logs/

# Output folders that are runtime-only. Keep tracked templates/docs elsewhere under output/.
output/repos/
output/logs/
output/folder/AppMagic-*/
output/Appmagic-*.xlsx
Cache/

# Local skill private environment files.
env.local.md
*.local.md

# Common local noise.
*.log
*.tmp
*.bak
Thumbs.db
desktop.ini

# Python bytecode caches.
__pycache__/
*.py[cod]
