# Local Codex runtime state, credentials, sessions, logs, caches.
.codex/
.agents/
.bashshim-test/
.private/

# Git provider tokens, never commit.
.github_token
.gitee_token
*.token

# AMDC browser profiles and account/session data.
.amdc-auth.json
.amdc-userdata*/
.playwright-auth/

# Temporary folders and dependencies.
ai-temp/
node_modules/
migration-logs/

# Output folders that are runtime-only. Keep tracked templates/docs elsewhere under output/.
output/repos/
output/logs/
output/folder/AMDC-*/
output/AMDC-*.xlsx
Cache/

# Local skill private environment files.
env.local.md
*.local.md

# Common local noise.
.playwright-cli/
artifacts/
diagrams/
tmp/
tools/xiaohongshu-mcp/cookies.json
tools/xiaohongshu-mcp/*.log*
*.log
*.tmp
*.bak
Thumbs.db
desktop.ini

# Python bytecode caches.
__pycache__/
*.py[cod]
