<?xml version="1.0" encoding="UTF-16"?>
<!--
  AppMagic Weekly Run — Windows Task Scheduler 模板
  导入: schtasks /create /xml "weekly-run.xml" /tn "AppMagic Weekly"
  修改: 确保 npm 全局 bin 目录在 PATH 中，或把 Command 改为 am 的绝对路径
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>AppMagic 周报自动采集 — 每周一早 09:00</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-05T09:00:00</StartBoundary>
      <ScheduleByWeek>
        <DaysOfWeek>
          <Monday />
        </DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>true</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>am</Command>
      <Arguments>run</Arguments>
      <!-- 修改为实际 AppMagic 项目根目录 -->
      <WorkingDirectory>C:\AppMagicProject</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
