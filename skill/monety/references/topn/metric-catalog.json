{
  "version": 1,
  "language": "zh-CN",
  "purpose": "把 TopOn 导出列转换为 Data Analytics 可稳定理解的规范字段、定义、公式和聚合规则。",
  "source_precedence": [
    "https://help.toponad.net/cn/docs/DVM3Tf",
    "https://help.toponad.net/cn/docs/qlHqYM",
    "https://help.toponad.net/cn/docs/5e6DnV",
    "https://help.toponad.net/cn/docs/dukFyc"
  ],
  "global_rules": [
    "带 API 后缀的指标来自第三方广告平台报表 API；没有 API 后缀且非收益的指标通常来自 TopOn SDK 统计。",
    "预估收益与预估 eCPM 是 TopOn 估算口径，不等同于第三方广告平台 API 收益或实际 eCPM。",
    "次数、设备数、人均次数属于不同统计方式，不得相加或放在同一个分母体系内计算。",
    "比率、eCPM、ARPDAU、人均次数和独立用户数必须按定义重算或保留原粒度，不得做行级简单平均。"
  ],
  "metrics": {
    "date": {
      "source_columns": ["日期"],
      "display_name": "日期",
      "semantic_name_en": "report_date",
      "kind": "dimension",
      "data_type": "date",
      "aggregation": "none",
      "definition": "数据产生的统计日期或时间段。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/DVM3Tf"]
    },
    "statistic_type": {
      "source_columns": ["统计方式"],
      "display_name": "统计方式",
      "semantic_name_en": "funnel_statistic_type",
      "kind": "dimension",
      "data_type": "string",
      "aggregation": "none",
      "definition": "漏斗事件的统计口径：次数按事件发生次数，设备按发生事件的设备数，人均次数为次数除以设备数。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/qlHqYM"]
    },
    "dau": {
      "source_columns": ["DAU"],
      "display_name": "DAU",
      "semantic_name_en": "daily_active_users",
      "kind": "metric",
      "data_type": "number",
      "unit": "devices",
      "aggregation": "non_additive_distinct_users",
      "definition": "每天打开应用并初始化 TopOn SDK 的独立设备用户数；不同筛选维度下代表相应范围的活跃用户，汇总行可能不去重。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/DVM3Tf", "https://help.toponad.net/cn/docs/5e6DnV"]
    },
    "deu": {
      "source_columns": ["DEU"],
      "display_name": "DEU",
      "semantic_name_en": "daily_engaged_ad_users",
      "kind": "metric",
      "data_type": "number",
      "unit": "devices",
      "aggregation": "non_additive_distinct_users",
      "definition": "每天展示过广告的独立设备用户数；数值随筛选维度变化。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/DVM3Tf"]
    },
    "new_user_share": {
      "source_columns": ["新用户占比"],
      "display_name": "新用户占比",
      "semantic_name_en": "new_user_share_of_dau",
      "kind": "metric",
      "data_type": "rate",
      "unit": "fraction",
      "aggregation": "recompute_from_new_users_and_dau",
      "formula": "new_users / dau",
      "definition": "首次使用应用的新增用户数占 DAU 的比例。",
      "documentation_status": "user_confirmed_current_definition",
      "validation_status": "definition_known_export_inputs_missing",
      "validation_note": "当前综合报表不导出 new_users，无法从该文件独立复算。",
      "sources": ["user_confirmation:2026-07-21", "https://help.toponad.net/cn/docs/DVM3Tf"]
    },
    "penetration_rate": {
      "source_columns": ["渗透率"],
      "display_name": "渗透率",
      "semantic_name_en": "ad_user_penetration_rate",
      "kind": "metric",
      "data_type": "rate",
      "unit": "fraction",
      "aggregation": "recompute_from_deu_and_dau",
      "formula": "deu / dau",
      "definition": "每天展示过广告的独立设备用户数占 DAU 的比例。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/DVM3Tf"]
    },
    "estimated_revenue_share": {
      "source_columns": ["预估收益占比"],
      "display_name": "预估收益占比",
      "semantic_name_en": "estimated_revenue_share",
      "kind": "metric",
      "data_type": "rate",
      "unit": "fraction",
      "aggregation": "recompute_from_report_total_estimated_revenue",
      "formula": "estimated_revenue / report_total_estimated_revenue",
      "definition": "当前行预估收益占本次报表汇总预估收益的比例。",
      "documentation_status": "user_confirmed_current_definition",
      "validation_status": "recomputable_from_export_summary",
      "validation_note": "优先使用导出汇总行的预估收益作为分母；缺少汇总行时才对同一筛选范围的互斥明细求和。",
      "sources": ["user_confirmation:2026-07-21", "https://help.toponad.net/cn/docs/DVM3Tf"]
    },
    "estimated_revenue": {
      "source_columns": ["预估收益"],
      "display_name": "预估收益",
      "semantic_name_en": "topon_estimated_ad_revenue",
      "kind": "metric",
      "data_type": "currency",
      "aggregation": "sum_same_currency_mutually_exclusive_grain",
      "definition": "TopOn 根据 SDK 展示和价格估算的收益；常规广告源使用人工 eCPM，竞价广告源使用实时展示价格。不是第三方平台最终结算收益。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/DVM3Tf"]
    },
    "revenue_api": {
      "source_columns": ["收益 API", "收益API"],
      "display_name": "收益 API",
      "semantic_name_en": "third_party_reported_revenue",
      "kind": "metric",
      "data_type": "currency",
      "aggregation": "sum_same_currency_supported_grain",
      "definition": "TopOn 通过报表 API 从第三方广告平台拉取的收益；API 指标不支持部分 TopOn 内部维度拆分。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/DVM3Tf", "https://help.toponad.net/cn/docs/dukFyc"]
    },
    "revenue_gap_rate": {
      "source_columns": ["收益GAP", "收益 GAP"],
      "display_name": "收益 GAP",
      "semantic_name_en": "estimated_vs_api_revenue_gap_rate",
      "kind": "metric",
      "data_type": "rate",
      "unit": "fraction",
      "aggregation": "recompute_after_aggregation",
      "formula": "(estimated_revenue - revenue_api) / revenue_api",
      "definition": "TopOn 预估收益与第三方平台 API 收益之间的相对差异。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/DVM3Tf"]
    },
    "estimated_arpdau": {
      "source_columns": ["预估ARPDAU", "预估 ARPDAU"],
      "display_name": "预估 ARPDAU",
      "semantic_name_en": "estimated_revenue_per_dau",
      "kind": "metric",
      "data_type": "currency_per_device",
      "aggregation": "recompute_from_estimated_revenue_and_dau",
      "formula": "estimated_revenue / dau",
      "definition": "每个日活设备对应的 TopOn 预估收益。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/DVM3Tf"]
    },
    "impressions_per_dau": {
      "source_columns": ["展示/DAU"],
      "display_name": "展示/DAU",
      "semantic_name_en": "impressions_per_daily_active_user",
      "kind": "metric",
      "data_type": "number",
      "unit": "impressions_per_device",
      "aggregation": "recompute_from_impressions_and_dau",
      "formula": "impressions / dau",
      "definition": "每个日活设备的平均广告展示次数。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/DVM3Tf"]
    },
    "estimated_ecpm": {
      "source_columns": ["预估 eCPM", "预估eCPM"],
      "display_name": "预估 eCPM",
      "semantic_name_en": "topon_estimated_ecpm",
      "kind": "metric",
      "data_type": "currency_per_thousand_impressions",
      "aggregation": "recompute_from_estimated_revenue_and_impressions",
      "formula": "estimated_revenue / impressions * 1000",
      "definition": "TopOn 预估收益除以 TopOn 统计展示并乘以 1000；不是第三方平台 API eCPM。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/DVM3Tf"]
    },
    "ad_source_requests": {
      "source_columns": ["广告源请求"],
      "display_name": "广告源请求",
      "semantic_name_en": "ad_source_request_attempts",
      "kind": "metric",
      "data_type": "number",
      "unit": "requests",
      "aggregation": "sum_mutually_exclusive_ad_source_grain",
      "definition": "TopOn 按瀑布排序向广告平台广告源发起的请求次数；一次流量请求可能对应多次广告源请求。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/DVM3Tf"]
    },
    "bidding_requests": {
      "source_columns": ["竞价"],
      "display_name": "竞价",
      "semantic_name_en": "header_bidding_requests",
      "kind": "metric",
      "data_type": "number",
      "unit": "bid_requests",
      "aggregation": "sum_mutually_exclusive_grain",
      "definition": "头部竞价广告源发起的竞价次数。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/DVM3Tf"]
    },
    "bidding_response_ecpm": {
      "source_columns": ["竞价响应eCPM"],
      "display_name": "竞价响应 eCPM",
      "semantic_name_en": "average_bid_response_ecpm",
      "kind": "metric",
      "data_type": "currency_per_thousand_impressions",
      "aggregation": "weighted_average_requires_bid_response_count",
      "definition": "头部竞价广告源响应竞价时，广告平台返回的平均 eCPM。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/DVM3Tf"]
    },
    "bidding_response_rate": {
      "source_columns": ["竞价响应率", "询价响应率", "竞价询价响应率"],
      "display_name": "竞价响应率",
      "semantic_name_en": "header_bidding_response_rate",
      "kind": "metric",
      "data_type": "rate",
      "unit": "fraction",
      "aggregation": "recompute_from_bid_responses_and_bidding_requests",
      "formula": "bid_responses / bidding_requests",
      "definition": "头部竞价广告源的询价或竞价响应次数占竞价次数的比例。",
      "documentation_status": "user_confirmed_current_definition",
      "validation_status": "definition_known_export_inputs_missing",
      "validation_note": "当前综合报表不导出 bid_responses，无法独立复算。",
      "sources": ["user_confirmation:2026-07-21", "https://help.toponad.net/cn/docs/DVM3Tf"]
    },
    "ad_source_fill_rate": {
      "source_columns": ["广告源填充率"],
      "display_name": "广告源填充率",
      "semantic_name_en": "ad_source_fill_rate",
      "kind": "metric",
      "data_type": "rate",
      "unit": "fraction",
      "aggregation": "recompute_from_ad_source_fills_and_requests",
      "formula": "ad_source_fills / ad_source_requests",
      "definition": "广告源向广告平台发送请求后，广告平台返回成功的次数占广告源请求次数的比例；不等同于流量填充率。",
      "documentation_status": "user_confirmed_current_definition",
      "validation_status": "definition_known_export_inputs_missing",
      "validation_note": "当前综合报表不导出 ad_source_fills，无法独立复算。",
      "sources": ["user_confirmation:2026-07-21", "https://help.toponad.net/cn/docs/DVM3Tf"]
    },
    "impressions_api": {
      "source_columns": ["展示 API", "展示API"],
      "display_name": "展示 API",
      "semantic_name_en": "third_party_reported_impressions",
      "kind": "metric",
      "data_type": "number",
      "unit": "impressions",
      "aggregation": "sum_supported_api_grain",
      "definition": "TopOn 通过报表 API 从第三方广告平台拉取的广告曝光次数；不支持部分 TopOn 内部维度和部分漏斗统计方式。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/DVM3Tf", "https://help.toponad.net/cn/docs/qlHqYM"]
    },
    "impression_rate": {
      "source_columns": ["展示率"],
      "display_name": "展示率",
      "semantic_name_en": "topon_impression_rate",
      "kind": "metric",
      "data_type": "rate",
      "unit": "fraction",
      "aggregation": "recompute_with_grain_specific_fill_denominator",
      "formula": "impressions / fills_at_current_grain",
      "definition": "TopOn 统计的广告展示数占当前报表粒度填充数的比例。",
      "documentation_status": "user_confirmed_current_definition",
      "validation_status": "requires_grain_specific_denominator",
      "validation_note": "当前综合报表未导出对应填充数，且分母随是否包含广告源维度变化，只能引用导出值。",
      "sources": ["user_confirmation:2026-07-21", "https://help.toponad.net/cn/docs/DVM3Tf", "https://help.toponad.net/cn/docs/5e6DnV"]
    },
    "impressions": {
      "source_columns": ["展示", "展示数", "展示量"],
      "display_name": "展示",
      "semantic_name_en": "topon_confirmed_impressions",
      "kind": "metric",
      "data_type": "number",
      "unit": "impressions",
      "aggregation": "sum_mutually_exclusive_grain",
      "definition": "TopOn 收到广告平台 SDK 展示成功回调后统计的展示次数；与第三方平台展示 API 口径可能不同。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/DVM3Tf", "https://help.toponad.net/cn/docs/qlHqYM"]
    },
    "impression_share": {
      "source_columns": ["展示占比"],
      "display_name": "展示占比",
      "semantic_name_en": "impression_share",
      "kind": "metric",
      "data_type": "rate",
      "unit": "fraction",
      "aggregation": "recompute_from_report_total_impressions",
      "formula": "impressions / report_total_impressions",
      "definition": "当前行展示数占本次报表汇总展示数的比例。",
      "documentation_status": "user_confirmed_current_definition",
      "validation_status": "recomputable_from_export_summary",
      "validation_note": "优先使用导出汇总行的展示数作为分母；缺少汇总行时才对同一筛选范围的互斥明细求和。",
      "sources": ["user_confirmation:2026-07-21", "https://help.toponad.net/cn/docs/DVM3Tf"]
    },
    "app_starts": {
      "source_columns": ["应用启动"],
      "display_name": "应用启动",
      "semantic_name_en": "app_start_and_topon_sdk_initialization",
      "kind": "metric",
      "data_type": "number",
      "aggregation": "depends_on_statistic_type",
      "definition": "应用启动并成功初始化 TopOn SDK；可能与第三方统计 SDK 的启动口径不同。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/qlHqYM"]
    },
    "config_fetches": {
      "source_columns": ["获取配置"],
      "display_name": "获取配置",
      "semantic_name_en": "ad_placement_strategy_fetches",
      "kind": "metric",
      "data_type": "number",
      "aggregation": "depends_on_statistic_type",
      "definition": "应用向 TopOn 服务器请求广告位策略的事件或设备数。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/qlHqYM"]
    },
    "traffic_requests": {
      "source_columns": ["流量请求"],
      "display_name": "流量请求",
      "semantic_name_en": "client_load_requests_to_topon",
      "kind": "metric",
      "data_type": "number",
      "aggregation": "depends_on_statistic_type",
      "definition": "应用客户端向 TopOn SDK 发起广告 Load 请求的事件或设备数；一次流量请求可能触发多个广告源请求。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/qlHqYM", "https://help.toponad.net/cn/docs/DVM3Tf"]
    },
    "traffic_fills": {
      "source_columns": ["流量填充"],
      "display_name": "流量填充",
      "semantic_name_en": "successful_topon_load_fills",
      "kind": "metric",
      "data_type": "number",
      "aggregation": "depends_on_statistic_type",
      "definition": "应用向 TopOn 请求广告后，TopOn 返回广告请求填充成功的事件或设备数。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/qlHqYM"]
    },
    "traffic_fill_rate": {
      "source_columns": ["流量填充率"],
      "display_name": "流量填充率",
      "semantic_name_en": "traffic_fill_rate",
      "kind": "metric",
      "data_type": "rate",
      "unit": "fraction",
      "aggregation": "recompute_within_statistic_type",
      "formula": "traffic_fills / traffic_requests",
      "definition": "流量填充数占流量请求数的比例，必须在相同统计方式内计算。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/qlHqYM"]
    },
    "ad_scene_arrivals": {
      "source_columns": ["到达广告场景"],
      "display_name": "到达广告场景",
      "semantic_name_en": "ad_scenario_arrivals",
      "kind": "metric",
      "data_type": "number",
      "aggregation": "depends_on_statistic_type",
      "definition": "用户到达广告场景并由应用调用 entryAdScenario 后记录的事件或设备数。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/qlHqYM"]
    },
    "ad_scene_arrival_rate": {
      "source_columns": ["广告场景到达率"],
      "display_name": "广告场景到达率",
      "semantic_name_en": "ad_scenario_device_arrival_rate",
      "kind": "metric",
      "data_type": "rate",
      "unit": "fraction",
      "aggregation": "recompute_from_device_counts",
      "formula": "ad_scene_arrival_devices / app_start_devices",
      "definition": "到达广告场景的设备数占应用启动设备数的比例。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/qlHqYM"]
    },
    "ad_ready_rate": {
      "source_columns": ["广告ready率", "广告Ready率"],
      "display_name": "广告 Ready 率",
      "semantic_name_en": "ad_ready_at_scenario_arrival_rate",
      "kind": "metric",
      "data_type": "rate",
      "unit": "fraction",
      "aggregation": "recompute_with_ready_arrival_numerator",
      "formula": "ad_ready_at_arrival / ad_scene_arrivals",
      "definition": "用户到达广告场景时，当前已有缓存广告可播放的次数占到达广告场景次数的比例；偏低时需要检查和优化预加载或缓存可用性。",
      "documentation_status": "user_confirmed_current_definition",
      "validation_status": "definition_known_export_inputs_missing",
      "validation_note": "帮助中心给出业务定义，但报表不导出广告已 Ready 的原始分子，无法独立复算。",
      "sources": ["user_confirmation:2026-07-21", "https://help.toponad.net/cn/docs/qlHqYM"]
    },
    "is_ready_queries": {
      "source_columns": ["查询isReady"],
      "display_name": "查询 isReady",
      "semantic_name_en": "is_ready_api_calls",
      "kind": "metric",
      "data_type": "number",
      "aggregation": "depends_on_statistic_type",
      "definition": "应用调用 TopOn isReady 接口的事件或设备数。",
      "documentation_status": "documented",
      "sources": ["https://help.toponad.net/cn/docs/qlHqYM"]
    },
    "is_ready_success_rate": {
      "source_columns": ["isReady成功率"],
      "display_name": "isReady 成功率",
      "semantic_name_en": "is_ready_true_rate",
      "kind": "metric",
      "data_type": "rate",
      "unit": "fraction",
      "aggregation": "recompute_from_true_results_and_queries",
      "formula": "is_ready_true_results / is_ready_queries",
      "definition": "TopOn isReady 接口返回 True 的次数占调用 TopOn isReady 接口次数的比例。",
      "documentation_status": "user_confirmed_current_definition",
      "validation_status": "definition_known_export_inputs_missing",
      "validation_note": "报表不导出 is_ready_true_results，无法独立复算。",
      "sources": ["user_confirmation:2026-07-21", "https://help.toponad.net/cn/docs/qlHqYM"]
    },
    "display_triggers": {
      "source_columns": ["触发展示"],
      "display_name": "触发展示",
